# ========================================
# Xeno Channel Service — Environment Variables
# ========================================
# Copy to .env and update the values.
# ========================================

# --- Server ---
PORT=3001

# --- Spring Boot Webhook Endpoint ---
WEBHOOK_URL=http://localhost:8080/api/webhook/receipt

# --- Shared Secret (must match Spring Boot's WEBHOOK_SECRET) ---
CHANNEL_SECRET=supersecretkey123
